---
import Base from '~/layouts/Base.astro';
import Footer from '~/components/Footer.astro';
import PageTitle from '~/components/PageTitle.astro';
import Section from '~/components/Section.astro';
import Globe from '~/components/live/Globe.astro';
import Moving from '~/components/live/Moving.astro';
import Guestbook from '~/components/live/Guestbook.astro';
import Reading from '~/components/live/Reading.astro';
---

<Base
  title="Live — Anil Seervi"
  description="What I'm listening to, shipping, moving and watching — straight from the APIs, unedited."
  ogImage="/og/live.png"
>
  <as-live-data data-load="idle">
    <!-- hero: title + right-now rows beside the 280px globe column -->
    <div class="hero">
      <div class="hero-left">
        <PageTitle
          title="live"
          sub="What I'm listening to, shipping, moving and watching — straight from the APIs, unedited."
        />
        <div class="now-rows">
          <div class="nrow" data-row="clock">
            <span class="nlabel">clock</span>
            <as-clock class="nval hi" data-format="time">09:06 ist · bengaluru</as-clock>
          </div>
          <div class="nrow" data-row="weather">
            <span class="nlabel">weather</span>
            <span class="nvcell">
              <span class="sk" data-sk style="height:12px;width:58%"></span>
              <span class="nval" data-val data-live="weather"></span>
            </span>
          </div>
          <div class="nrow" data-row="coords">
            <span class="nlabel">coords</span>
            <span class="nval">12.97° N · 77.59° E</span>
          </div>
          <!-- the one-line `reading` vital retired here: it earned a section of
               its own (design_handoff_reading), below the vitals. -->
        </div>
      </div>
      <div class="globe-col">
        <Globe />
        <span class="globe-cap">bengaluru — home</span>
      </div>
    </div>

    <Reading />

    <section data-section="spotify">
      <Section label="LISTENING · SPOTIFY" phaseNote />
      <div class="rows">
        <div class="lrow" data-row="now">
          <span class="rlabel eq-label"
            ><span class="eq" data-eq aria-hidden="true"><span></span><span></span><span
              ></span></span>now</span>
          <span class="tcell">
            <span class="sk-now" data-sk aria-hidden="true"
              ><span style="height:15px;width:54%"></span><span
                class="sk-faint" style="height:10px;width:31%"></span></span>
            <span class="track hi" data-val data-live="now"><em data-part="title"></em><span
                data-part="tail"></span><span class="ctx" data-part="ctx"></span></span>
          </span>
        </div>
        <div class="lrow" data-row="last">
          <span class="rlabel">last played</span>
          <span class="tcell">
            <span class="sk" data-sk aria-hidden="true" style="height:13px;width:40%"></span>
            <span class="track muted" data-val data-live="last"><em data-part="title"></em><span
                data-part="tail"></span></span>
          </span>
        </div>
      </div>
    </section>

    <section data-section="github">
      <Section
        label="SHIPPING · GITHUB"
        meta="@AnilSeervi ↗"
        metaHref="https://github.com/AnilSeervi"
        external
      />
      <div class="contrib-wrap" data-contrib>
        <span class="gh-sk" data-gh-sk aria-hidden="true"></span>
        <as-contrib>
          <canvas width="1404" height="182" style="width:702px;height:91px" aria-hidden="true"
          ></canvas>
        </as-contrib>
      </div>
      <!-- one reserved line, two tenants: the year's total by default, and the
           hovered day's detail in its place. Never both, so no reflow. -->
      <div class="contrib-meta">
        <span data-live="contrib-total"></span><span
          class="contrib-readout"
          data-contrib-readout
          hidden><span data-part="main"></span><span class="dim" data-part="ctx"></span></span
        >
        <span class="desktop-only">52 weeks</span><span class="mobile-only">23 weeks shown</span>
      </div>
    </section>

    <Moving />

    <section class="watching-sec" data-section="mal">
      <Section label="AIRING NOW · MYANIMELIST" meta="weeb stats, worn proudly" metaMobile="" />
      <div class="rows">
        <div class="lrow" data-row="watching">
          <span class="rlabel">anime</span>
          <span class="tcell">
            <span class="sk" data-sk aria-hidden="true" style="height:13px;width:60%"></span>
            <span class="track hi" data-val data-live="watching"><em data-part="title"></em><span
                data-part="tail"></span></span>
          </span>
        </div>
        <!-- manga lives here, not on the Hardcover shelf: those sixteen volumes
             were deleted from that account so the two sources can't disagree -->
        <div class="lrow" data-row="manga">
          <span class="rlabel">manga</span>
          <span class="tcell">
            <span class="sk" data-sk aria-hidden="true" style="height:13px;width:52%"></span>
            <span class="track hi" data-val data-live="manga"><em data-part="title"></em><span
                data-part="tail"></span></span>
          </span>
        </div>
        <div class="lrow" data-row="shelf">
          <span class="rlabel">the shelf</span>
          <span class="tcell">
            <span class="sk sk-dim" data-sk aria-hidden="true" style="height:13px;width:55%"></span>
            <span class="shelf" data-val data-live="shelf"><span data-part="head"></span><span
                class="accent" data-part="mean"></span></span>
          </span>
        </div>
      </div>
    </section>

    <Guestbook />
  </as-live-data>

  <div class="foot">
    <Footer>
      <a class="chain" href="/about">~/about →</a>
    </Footer>
  </div>
</Base>

<style>
  as-live-data,
  as-contrib {
    display: block;
  }

  /* hero — title + right-now rows left, globe column right (prototype 6d) */
  .hero {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 48px;
    align-items: center;
    margin-bottom: 56px;
  }
  /* live's sub sits tighter than the PageTitle default (prototype: 28px / 30em) */
  .hero-left :global(.sub) {
    margin-bottom: 28px;
    max-width: 30em;
  }

  .now-rows {
    display: flex;
    flex-direction: column;
  }
  .nrow {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--hair-row);
    align-items: baseline;
  }
  .nrow:last-child {
    border-bottom: none;
  }
  .nlabel {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--meta);
  }
  .nval {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
  }
  .nval.hi {
    color: var(--text-hi);
  }
  .globe-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .globe-cap {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }

  /* section data rows (listening / watching) */
  .rows {
    display: flex;
    flex-direction: column;
    margin-bottom: 52px;
  }
  .lrow {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 20px;
    padding: 12px 0;
    border-bottom: 1px solid var(--hair-row);
    align-items: baseline;
  }
  .lrow:last-child {
    border-bottom: none;
  }
  .rlabel {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--meta);
  }

  /* equalizer — 3 bars, staggered as-eq; runs only while isPlaying */
  .eq-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .eq {
    display: inline-flex;
    gap: 2px;
    align-items: flex-end;
    height: 11px;
  }
  .eq span {
    width: 2.5px;
    height: 11px;
    background: var(--live-green);
    transform-origin: bottom;
    animation: as-eq 1s ease-in-out infinite;
    animation-play-state: paused;
  }
  .eq span:nth-child(2) {
    animation-delay: 0.25s;
  }
  .eq span:nth-child(3) {
    animation-delay: 0.5s;
  }
  .eq.playing span {
    animation-play-state: running;
  }

  .track {
    font-size: 15.5px;
  }
  .track em {
    font-family: var(--font-serif);
    font-size: 17px;
  }
  .track.hi em {
    color: var(--text-hi);
  }
  .track.muted {
    color: var(--text-muted);
  }
  .ctx {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
  }

  /* contribution field */
  .contrib-wrap {
    margin-bottom: 14px;
    /* canvas keeps the design's fixed 702px; scroll instead of breaking layout on narrow */
    overflow-x: auto;
  }
  as-contrib canvas {
    display: block;
  }
  .contrib-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--faint);
    margin-bottom: 48px;
  }
  /* the hovered day reads a notch brighter than the total it replaces; its
     closing clause drops back to --faint. No `display` here — [hidden] must
     keep winning while the total holds the line. */
  .contrib-readout {
    color: var(--text-muted);
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .contrib-readout .dim {
    color: var(--faint);
  }
  /* cells are 10px at both breakpoints, so the grid is aimable by mouse or
     thumb — crosshair advertises that the field answers questions */
  as-contrib canvas {
    cursor: crosshair;
  }

  /* watching */
  .shelf {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
  }
  .shelf .accent {
    color: var(--as-accent);
  }
  /* frame 6d: 'weeb stats, worn proudly' reads --faint, not the Section default */
  .watching-sec :global(.section-head .meta) {
    color: var(--faint);
  }

  /* footer gap is owned by the last section's margin (prototype) */
  .foot :global(footer) {
    margin-top: 0;
  }

  /* ================= loading / waiting (8a) ================= */
  /* each value cell stacks a skeleton over the real value; only one shows
     (global [data-load] gating), the row min-heights hold the space */
  .tcell,
  .nvcell {
    min-width: 0;
  }
  /* 'now' skeleton is two stacked bars — center it against the eq label */
  .lrow[data-row='now'] {
    align-items: center;
  }
  /* two stacked bars; display is owned by the global [data-load] gating, so
     the gap rides on margin (flex here would be overridden to block) */
  .sk-now span {
    display: block;
    border-radius: 3px;
    background: rgba(237, 230, 218, 0.07);
  }
  .sk-now span + span {
    margin-top: 8px;
  }
  .sk-now span.sk-faint {
    background: rgba(237, 230, 218, 0.05);
  }

  /* equalizer sits dim but still animating while the feed is fetching (8a) */
  .eq {
    opacity: 1;
    transition: opacity 0.5s ease;
  }
  as-live-data[data-load='waiting'] .eq {
    opacity: 0.25;
  }
  as-live-data[data-load='waiting'] .eq span {
    animation-play-state: running;
  }

  /* github: dot-field placeholder holds the 91px grid until the canvas lands;
     it also IS the 'didn't answer' state (stays, caption reads the error) */
  .contrib-wrap {
    position: relative;
    min-height: 91px;
  }
  .gh-sk {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(237, 230, 218, 0.07) 2px, transparent 2.6px);
    background-size: 13.5px 13px;
    background-position: 2px 2px;
    animation: as-breathe 1.9s ease-in-out infinite;
  }
  .contrib-wrap as-contrib canvas {
    opacity: 0;
  }
  .contrib-wrap.arrived .gh-sk {
    display: none;
  }
  .contrib-wrap.arrived as-contrib canvas {
    opacity: 1;
    animation: as-fade 0.5s ease both;
  }
  /* reserve the meta line so the empty → text (or error) swap never reflows */
  .contrib-meta {
    min-height: 16px;
  }
  @media (prefers-reduced-motion: reduce) {
    .gh-sk {
      opacity: 0.34;
    }
  }

  /* ================= mobile (7d) ================= */
  @media (max-width: 768px) {
    /* hero stacks; globe drops between the intro and the right-now rows
       (display:contents lifts the title/sub/now-rows so order can interleave
       the globe, a sibling of .hero-left) */
    .hero {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin-bottom: 40px;
    }
    .hero-left {
      display: contents;
    }
    .hero-left :global(h1) {
      order: 1;
    }
    .hero-left :global(.sub) {
      order: 2;
      margin-bottom: 26px;
    }
    .globe-col {
      order: 3;
      margin-bottom: 26px;
    }
    .now-rows {
      order: 4;
    }
    .globe-cap {
      font-size: 10.5px;
    }

    /* right-now rows: 76px label, still side-by-side (7d drops coords) */
    .nrow {
      grid-template-columns: 76px 1fr;
      gap: 12px;
    }
    .nrow[data-row='coords'] {
      display: none;
    }
    .nlabel {
      font-size: 11px;
    }
    .nval {
      font-size: 12px;
    }
    /* listening + watching rows: label above value (7d) */
    .rows {
      margin-bottom: 40px;
    }
    .lrow {
      grid-template-columns: 1fr;
      gap: 4px;
      padding: 11px 0;
    }
    .rlabel {
      font-size: 11px;
    }
    .track {
      font-size: 14px;
    }
    .track em {
      font-size: 16px;
    }
    .shelf {
      font-size: 12px;
    }

    /* the "brass runs hotter" clause is desktop-only, so the short total +
       "23 weeks shown" fit one space-between row (7d) */
    .contrib-wrap {
      margin-bottom: 10px;
    }
    .contrib-meta {
      font-size: 10.5px;
      margin-bottom: 40px;
    }
  }
</style>

<script>
  import '~/islands/clock';
  import '~/islands/contrib';
  import '~/islands/live-data';
  import '~/islands/moving';
  import '~/islands/reading';
</script>
