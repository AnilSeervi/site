---
import Base from '~/layouts/Base.astro';
import Footer from '~/components/Footer.astro';
import PageTitle from '~/components/PageTitle.astro';
import Section from '~/components/Section.astro';
import ProjectSpread from '~/components/ProjectSpread.astro';
import ProjectRow from '~/components/ProjectRow.astro';
import { archive, contributions, experience, spreads } from '~/config/site';

/** each row links to the public search that produced its number */
const prSearch = (repo: string) =>
  `https://github.com/${repo}/pulls?q=${encodeURIComponent('is:pr author:AnilSeervi')}`;
---

<Base
  title="Work — Anil Seervi"
  description="The day job, and the open source that got me here."
  ogImage="/og/work.png"
>
  <PageTitle title="work" sub="The day job, and the open source that got me here." />

  <Section label="EXPERIENCE" />
  <div class="xp-list">
    {
      experience.map((job) => (
        <article class="xp-row">
          <div class="xp-head">
            <h2 class="xp-name">{job.name}</h2>
            <span class="xp-meta">{job.meta}</span>
          </div>
          <p class="xp-ladder">{job.ladder}</p>
          <ul class="xp-bullets">
            {job.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <Section
    label="CONTRIBUTIONS"
    meta={`${contributions.meta} ↗`}
    metaMobile="259 prs ↗"
    metaHref={contributions.href}
    external
    mb={12}
  />
  <p class="lede">{contributions.lede}</p>
  <div class="cb-list">
    {
      contributions.repos.map((c) => (
        <a class="cb-row" href={prSearch(c.repo)} target="_blank" rel="noopener noreferrer">
          <span class="cb-repo">{c.repo}</span>
          <span class="cb-note">{c.note}</span>
          <span class="cb-count">{c.prs}</span>
        </a>
      ))
    }
  </div>
  <p class="cb-tail">{contributions.tail}</p>

  {/* The handoff calls this page island-free, and it nearly is. This one is
      invisible and earns its place: it fills DevFolio's ★/forks from
      /api/github, and the alternative is a hardcoded count that had already
      drifted from 486/165 to "★485 · 166" in opposite directions. */}
  <as-home-data aria-hidden="true"></as-home-data>

  <Section
    label="OPEN SOURCE"
    meta="sources on github ↗"
    metaMobile="sources ↗"
    metaHref="https://github.com/AnilSeervi?tab=repositories"
    external
  />
  <div class="spreads">
    {spreads.map((project) => <ProjectSpread project={project} />)}
  </div>

  {/* the quiet tier: finished work, given a line each instead of a spread */}
  <div class="archive">
    <p class="archive-label">FROM THE ARCHIVE</p>
    <div class="archive-rows">
      {archive.map((project) => <ProjectRow project={project} />)}
    </div>
  </div>

  <Footer>
    <a class="chain" href="/writing">~/writing →</a>
  </Footer>
</Base>

<style>
  /* ---- EXPERIENCE (frame 6b) ---- */
  .xp-list {
    display: flex;
    flex-direction: column;
    margin-bottom: 52px;
  }

  .xp-row {
    padding: 4px 0 2px;
  }
  .xp-row + .xp-row {
    border-top: 1px solid var(--hair-row);
    padding-top: 18px;
    margin-top: 18px;
  }

  .xp-head {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 20px;
    align-items: baseline;
  }

  .xp-name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 20px;
    color: var(--text-hi);
    margin: 0;
  }

  /* the row header can only hold one title — the ladder holds the other two */
  .xp-ladder {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--meta);
    margin: 7px 0 14px;
  }

  .xp-bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .xp-bullets li {
    position: relative;
    padding-left: 16px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
  }
  /* same 4px accent square the /about milestones use — one vocabulary for
     "a thing that happened" across both pages */
  .xp-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 4px;
    height: 4px;
    background: color-mix(in srgb, var(--as-accent) 55%, transparent);
  }

  .xp-meta {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--meta);
    white-space: nowrap;
  }

  /* ---- CONTRIBUTIONS ---- */
  /* same voice as .why-slot below: a serif italic line is this page's narrator */
  .lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--quote);
    margin: 0 0 18px;
  }

  .cb-list {
    display: flex;
    flex-direction: column;
  }

  .cb-row {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    gap: 20px;
    padding: 12px 0;
    align-items: baseline;
    text-decoration: none;
    color: inherit;
    transition: background 180ms ease;
  }
  .cb-row:not(:last-child) {
    border-bottom: 1px solid var(--hair-row);
  }
  .cb-row:hover {
    background: rgba(237, 230, 218, 0.035);
  }

  .cb-repo {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-hi);
    transition: color 180ms ease;
  }
  .cb-row:hover .cb-repo {
    color: var(--as-accent);
  }

  .cb-note {
    font-size: 14px;
    line-height: 1.55;
    color: var(--faint);
  }

  /* tabular so the column reads as a column, not seven separate numbers */
  .cb-count {
    font-family: var(--font-mono);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    color: var(--meta);
    text-align: right;
  }

  .cb-tail {
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--faint);
    margin: 16px 0 56px;
  }

  /* ---- OPEN SOURCE ----
     The rows themselves live in ProjectSpread / ProjectRow; only the outer
     rhythm is the page's business. Gone from here: the 150px/1fr/76px/auto
     table, the hover-only why slot, and the row sparklines — the why is inline
     now, and the sparks were drawing an all-zero series for five of six repos. */
  .spreads {
    /* the last spread's own divider doubles as the rule above the archive */
    margin-bottom: 0;
  }

  .archive {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 28px;
    padding: 26px 0 4px;
    margin-bottom: 60px;
  }

  .archive-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--faint);
    margin: 0;
  }

  .archive-rows {
    min-width: 0;
  }

  /* frame 6b: footer rule sits 64px below the last row. Footer's default is
     96px via the scoped `footer[data-astro-cid]` rule (0,1,1) — :last-child
     lifts this override to (0,1,2) so it wins. */
  :global(main > footer:last-child) {
    margin-top: 64px;
  }

  /* ================= mobile (7b) ================= */
  @media (max-width: 768px) {
    .xp-list {
      margin-bottom: 40px;
    }
    .xp-name {
      font-size: 18px;
    }
    .xp-ladder {
      font-size: 10.5px;
      margin: 6px 0 12px;
    }
    .xp-bullets {
      gap: 8px;
    }
    .xp-bullets li {
      font-size: 13.5px;
      line-height: 1.55;
      padding-left: 14px;
    }
    .xp-bullets li::before {
      top: 8px;
    }
    .xp-meta {
      font-size: 11px;
    }

    .lede {
      font-size: 14.5px;
      margin-bottom: 14px;
    }
    /* repo + count share the first line; the gloss wraps under both */
    .cb-row {
      grid-template-columns: 1fr auto;
      gap: 3px 12px;
      padding: 11px 0;
    }
    .cb-repo {
      grid-column: 1;
      grid-row: 1;
      font-size: 12px;
    }
    .cb-count {
      grid-column: 2;
      grid-row: 1;
      font-size: 12px;
    }
    .cb-note {
      grid-column: 1 / -1;
      grid-row: 2;
      font-size: 12.5px;
      line-height: 1.5;
    }
    /* an empty gloss would still open a 2nd row and double the row height */
    .cb-note:empty {
      display: none;
    }
    .cb-tail {
      font-size: 12.5px;
      margin: 14px 0 44px;
    }

    /* the archive label stops being a left column and becomes a heading */
    .archive {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 18px 0 4px;
      margin-bottom: 44px;
    }
    .archive-label {
      font-size: 10.5px;
    }

    :global(main > footer:last-child) {
      margin-top: 48px;
    }
  }
</style>

<script>
  /* The only island left: it fills DevFolio's ★/forks from /api/github. The
     why-slot element is gone — the why is inline on every spread now, so there
     is nothing to reveal on hover and nothing that was invisible on touch.
     `spark` is gone too: /work has no sparklines in the 6b handoff. */
  import '~/islands/home-data';
</script>
