---
import Base from '~/layouts/Base.astro';
import Footer from '~/components/Footer.astro';
import PageTitle from '~/components/PageTitle.astro';
import Section from '~/components/Section.astro';
import { contributions, experience, projects, srcUrl } from '~/config/site';

/** each row links to the public search that produced its number */
const prSearch = (repo: string) =>
  `https://github.com/${repo}/pulls?q=${encodeURIComponent('is:pr author:AnilSeervi')}`;
---

<Base
  title="Work — Anil Seervi"
  description="The day job, and the open source that got me here."
  ogImage="/og/work.png"
>
  <PageTitle title="work" sub="The day job, and the open source that got me here." />

  <Section label="EXPERIENCE" />
  <div class="xp-list">
    {
      experience.map((job) => (
        <article class="xp-row">
          <div class="xp-head">
            <h2 class="xp-name">{job.name}</h2>
            <span class="xp-meta">{job.meta}</span>
          </div>
          <p class="xp-ladder">{job.ladder}</p>
          <ul class="xp-bullets">
            {job.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <Section
    label="CONTRIBUTIONS"
    meta={`${contributions.meta} ↗`}
    metaMobile="259 prs ↗"
    metaHref={contributions.href}
    external
    mb={12}
  />
  <p class="lede">{contributions.lede}</p>
  <div class="cb-list">
    {
      contributions.repos.map((c) => (
        <a class="cb-row" href={prSearch(c.repo)} target="_blank" rel="noopener noreferrer">
          <span class="cb-repo">{c.repo}</span>
          <span class="cb-note">{c.note}</span>
          <span class="cb-count">{c.prs}</span>
        </a>
      ))
    }
  </div>
  <p class="cb-tail">{contributions.tail}</p>

  <!-- reuses the home fetcher: fills any <as-spark data-repo> in this page's main -->
  <as-home-data aria-hidden="true"></as-home-data>
  <as-whyslot>
    <Section
      label="PROJECTS"
      meta="sources on github ↗"
      metaMobile="sources ↗"
      metaHref="https://github.com/AnilSeervi?tab=repositories"
      external
      mb={12}
    />
    <p class="why-slot" data-why-slot>— hover a project for the why</p>
    <div class="os-list" data-why-list>
      {
        projects.map((project, i) => (
          <div class="os-row" data-why={project.why}>
            <a class="os-name" href={project.href} target="_blank" rel="noopener noreferrer">
              {project.name}
            </a>
            <span class="os-desc">
              {project.work}
              {/* SSR values are last-known fallbacks — as-home-data overwrites
                  both from /api/github, so the brag can't go stale again. The ★
                  lives INSIDE the span: the island writes `★N`, matching the
                  home proof strip, so a glyph out here would double it. */}
              {project.live === 'devfolio' && (
                <span class="os-num">
                  {' '}<span data-proof="stars">★486</span> · <span data-proof="forks">165</span> forks.
                </span>
              )}
            </span>
            <as-spark data-status={project.status} data-seed={String(7 + i)} data-repo={project.repo}>
              <canvas
                class="spark"
                width="144"
                height="36"
                style="width:72px;height:18px"
                data-status={project.status}
                aria-hidden="true"
              />
            </as-spark>
            {/* the row's second link. active/maintained/archived used to sit
                here, but it was the one thing on the page nobody could check —
                and it contradicted its neighbours: "archived" beside copy that
                says the site is still serving, "maintained" beside a repo with
                no commit in two years. A link either works or it doesn't. */}
            {srcUrl(project) && (
              <a
                class="os-src"
                href={srcUrl(project)}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${project.name} source on GitHub`}
              >
                src ↗
              </a>
            )}
          </div>
        ))
      }
    </div>
  </as-whyslot>

  <Footer left="astro · vercel ▲">
    <a class="chain" href="/writing">next — ~/writing →</a>
  </Footer>
</Base>

<style>
  /* ---- EXPERIENCE (frame 6b) ---- */
  .xp-list {
    display: flex;
    flex-direction: column;
    margin-bottom: 52px;
  }

  .xp-row {
    padding: 4px 0 2px;
  }
  .xp-row + .xp-row {
    border-top: 1px solid var(--hair-row);
    padding-top: 18px;
    margin-top: 18px;
  }

  .xp-head {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 20px;
    align-items: baseline;
  }

  .xp-name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 20px;
    color: var(--text-hi);
    margin: 0;
  }

  /* the row header can only hold one title — the ladder holds the other two */
  .xp-ladder {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--meta);
    margin: 7px 0 14px;
  }

  .xp-bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .xp-bullets li {
    position: relative;
    padding-left: 16px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
  }
  /* same 4px accent square the /about milestones use — one vocabulary for
     "a thing that happened" across both pages */
  .xp-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 4px;
    height: 4px;
    background: color-mix(in srgb, var(--as-accent) 55%, transparent);
  }

  .xp-meta {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--meta);
    white-space: nowrap;
  }

  /* ---- CONTRIBUTIONS ---- */
  /* same voice as .why-slot below: a serif italic line is this page's narrator */
  .lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--quote);
    margin: 0 0 18px;
  }

  .cb-list {
    display: flex;
    flex-direction: column;
  }

  .cb-row {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    gap: 20px;
    padding: 12px 0;
    align-items: baseline;
    text-decoration: none;
    color: inherit;
    transition: background 180ms ease;
  }
  .cb-row:not(:last-child) {
    border-bottom: 1px solid var(--hair-row);
  }
  .cb-row:hover {
    background: rgba(237, 230, 218, 0.035);
  }

  .cb-repo {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-hi);
    transition: color 180ms ease;
  }
  .cb-row:hover .cb-repo {
    color: var(--as-accent);
  }

  .cb-note {
    font-size: 14px;
    line-height: 1.55;
    color: var(--faint);
  }

  /* tabular so the column reads as a column, not seven separate numbers */
  .cb-count {
    font-family: var(--font-mono);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    color: var(--meta);
    text-align: right;
  }

  .cb-tail {
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--faint);
    margin: 16px 0 56px;
  }

  /* ---- OPEN SOURCE ---- */
  as-whyslot {
    display: block;
  }

  .why-slot {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 15.5px;
    color: var(--quote);
    min-height: 24px;
    margin: 0 0 16px;
  }

  .os-list {
    display: flex;
    flex-direction: column;
    margin-bottom: 64px;
  }

  .os-row {
    display: grid;
    grid-template-columns: 150px 1fr 76px auto;
    gap: 20px;
    padding: 15px 0;
    align-items: center;
    transition: background 180ms ease;
  }
  .os-row:not(:last-child) {
    border-bottom: 1px solid var(--hair-row);
  }
  .os-row:hover {
    background: rgba(237, 230, 218, 0.035);
  }

  .os-name {
    font-family: var(--font-serif);
    font-size: 20px;
    color: var(--text-hi);
    transition: color 180ms ease;
  }
  .os-row:hover .os-name {
    color: var(--as-accent);
  }

  .os-desc {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  as-spark {
    display: block;
  }
  .spark {
    display: block;
    opacity: 0.75;
  }
  /* the island hides itself when the repo's real 52-week series is empty —
     see spark.ts. Nothing here keys off `status` any more. */

  .os-src {
    font-family: var(--font-mono);
    font-size: 11px;
    white-space: nowrap;
    color: var(--meta);
    text-decoration: none;
    display: inline-block;
    transition:
      color 180ms ease,
      transform 180ms ease;
  }
  .os-src:hover {
    color: var(--as-accent);
    /* same ↗ lift the Section metas use */
    transform: translate(2px, -2px);
  }

  /* frame 6b: footer rule sits 64px below the last row. Footer's default is
     96px via the scoped `footer[data-astro-cid]` rule (0,1,1) — :last-child
     lifts this override to (0,1,2) so it wins. */
  :global(main > footer:last-child) {
    margin-top: 64px;
  }

  /* ================= mobile (7b) ================= */
  @media (max-width: 768px) {
    .xp-list {
      margin-bottom: 40px;
    }
    .xp-name {
      font-size: 18px;
    }
    .xp-ladder {
      font-size: 10.5px;
      margin: 6px 0 12px;
    }
    .xp-bullets {
      gap: 8px;
    }
    .xp-bullets li {
      font-size: 13.5px;
      line-height: 1.55;
      padding-left: 14px;
    }
    .xp-bullets li::before {
      top: 8px;
    }
    .xp-meta {
      font-size: 11px;
    }

    .lede {
      font-size: 14.5px;
      margin-bottom: 14px;
    }
    /* repo + count share the first line; the gloss wraps under both */
    .cb-row {
      grid-template-columns: 1fr auto;
      gap: 3px 12px;
      padding: 11px 0;
    }
    .cb-repo {
      grid-column: 1;
      grid-row: 1;
      font-size: 12px;
    }
    .cb-count {
      grid-column: 2;
      grid-row: 1;
      font-size: 12px;
    }
    .cb-note {
      grid-column: 1 / -1;
      grid-row: 2;
      font-size: 12.5px;
      line-height: 1.5;
    }
    /* an empty gloss would still open a 2nd row and double the row height */
    .cb-note:empty {
      display: none;
    }
    .cb-tail {
      font-size: 12.5px;
      margin: 14px 0 44px;
    }

    /* The why-line sits ABOVE the list, so any growth when it fills shoves the
       whole list down. 45px is exactly two lines at 14.5px/1.55 (2 × 22.475),
       which is what the longest `why` now needs — every project measured 0px of
       shift at that height. The old 42px was under even a two-line fill, so all
       five nudged 2.93px and DevFolio, then 114 chars and three lines, jumped
       25.41px. Keep every `why` under ~90 chars or this floor stops holding. */
    .why-slot {
      min-height: 45px;
      font-size: 14.5px;
      line-height: 1.55;
      margin: 0 0 10px;
    }
    .os-list {
      margin-bottom: 48px;
    }
    .os-row {
      grid-template-columns: 1fr auto;
      gap: 3px 12px;
      padding: 13px 0;
      align-items: baseline;
    }
    .os-row as-spark {
      display: none;
    }
    .os-name {
      grid-column: 1;
      grid-row: 1;
      font-size: 18px;
    }
    /* `src ↗` rides the name's line; 44px tall so it's a real tap target */
    .os-src {
      grid-column: 2;
      grid-row: 1;
      font-size: 10.5px;
      padding: 6px 0 6px 10px;
      margin: -6px 0;
    }
    .os-desc {
      grid-column: 1 / -1;
      grid-row: 2;
      font-size: 13.5px;
      line-height: 1.55;
    }

    :global(main > footer:last-child) {
      margin-top: 48px;
    }
  }
</style>

<script>
  import '~/islands/spark';
  import '~/islands/home-data';
  import { isMobile, onBreakpointChange } from '~/islands/breakpoint';

  if (!customElements.get('as-whyslot')) {
    class AsWhyslot extends HTMLElement {
      #slot: HTMLElement | null = null;
      #list: HTMLElement | null = null;
      #rows: HTMLElement[] = [];
      #showingDefault = true;
      #unsub: (() => void) | null = null;

      // desktop reveals on hover; mobile on tap (README 7b) — the prompt copy
      // follows the active affordance
      #defaultText() {
        return isMobile() ? '— tap a project for the why' : '— hover a project for the why';
      }

      #enter = (event: Event) => {
        const why = (event.currentTarget as HTMLElement).dataset.why;
        if (this.#slot && why) {
          this.#slot.textContent = why;
          this.#showingDefault = false;
        }
      };

      #reset = () => {
        if (this.#slot) this.#slot.textContent = this.#defaultText();
        this.#showingDefault = true;
      };

      connectedCallback() {
        this.#slot = this.querySelector('[data-why-slot]');
        this.#list = this.querySelector('[data-why-list]');
        this.#rows = Array.from(this.querySelectorAll<HTMLElement>('[data-why]'));
        this.#reset();
        this.#rows.forEach((row) => {
          row.addEventListener('mouseenter', this.#enter);
          row.addEventListener('click', this.#enter); // touch
        });
        this.#list?.addEventListener('mouseleave', this.#reset);
        // keep the prompt's hover/tap wording correct across a bp crossing
        this.#unsub = onBreakpointChange(() => {
          if (this.#showingDefault) this.#reset();
        });
      }

      disconnectedCallback() {
        this.#rows.forEach((row) => {
          row.removeEventListener('mouseenter', this.#enter);
          row.removeEventListener('click', this.#enter);
        });
        this.#list?.removeEventListener('mouseleave', this.#reset);
        this.#unsub?.();
        this.#unsub = null;
        this.#rows = [];
        this.#slot = null;
        this.#list = null;
      }
    }
    customElements.define('as-whyslot', AsWhyslot);
  }
</script>
