---
/** Section head: `01 · WORK` + filling hairline + optional right meta. */
interface Props {
  label: string;
  meta?: string;
  /** shorter meta shown ≤768px; '' hides it on mobile, omit to keep `meta` */
  metaMobile?: string;
  metaHref?: string;
  external?: boolean;
  /** margin-bottom override in px */
  mb?: number;
  /** renders a placeholder right meta the island flips to 'live'; excludes `meta` */
  phaseNote?: boolean;
}
const { label, meta, metaMobile, metaHref, external = false, mb = 20, phaseNote = false } = Astro.props;
const newTab = !!metaHref && /^https?:\/\//.test(metaHref);
const hasMobile = metaMobile !== undefined;
---

<div class="section-head" style={`margin-bottom:${mb}px`}>
  <span class="label">{label}</span>
  <span class="rule" aria-hidden="true"></span>
  {phaseNote && <span class="meta note" data-live="phase-note">fetching…</span>}
  {
    meta &&
      (metaHref ? (
        <a
          class:list={['meta', { external }]}
          href={metaHref}
          target={newTab ? '_blank' : undefined}
          rel={newTab ? 'noopener noreferrer' : undefined}
        >
          {hasMobile ? (
            <>
              <span class="desktop-only">{meta}</span>
              <span class="mobile-only">{metaMobile}</span>
            </>
          ) : (
            meta
          )}
        </a>
      ) : hasMobile ? (
        <span class="meta">
          <span class="desktop-only">{meta}</span>
          <span class="mobile-only">{metaMobile}</span>
        </span>
      ) : (
        <span class="meta">{meta}</span>
      ))
  }
</div>

<style>
  .section-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--as-accent);
    text-transform: uppercase;
  }

  .rule {
    flex: 1;
    border-bottom: 1px solid var(--hair-rule);
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--meta);
  }
  .meta.note {
    font-size: 11.5px;
    color: var(--faint);
  }

  a.meta {
    display: inline-block;
    transition:
      transform 180ms ease,
      color 180ms ease;
  }
  a.meta:hover {
    color: var(--text-hi);
  }
  a.meta.external:hover {
    transform: translate(2px, -2px);
  }

  @media (max-width: 768px) {
    .section-head {
      gap: 12px;
    }
    .label,
    .meta {
      font-size: 11px;
    }
  }
</style>
