---
/**
 * Section label pattern: `01 · WORK` + flex-filling hairline + optional right meta.
 * Right meta renders as a link when `metaHref` is given. `external` controls the
 * ↗ hover lift (translate(2px,-2px)) — some ↗ links are internal routes (e.g.
 * `all projects ↗` → /work), so a new tab is opened only for real http(s) URLs.
 */
interface Props {
  label: string;
  meta?: string;
  /** shorter meta shown ≤768px (mobile design trims several of these); ''
      hides the meta on mobile entirely. Omit to keep `meta` at every width. */
  metaMobile?: string;
  metaHref?: string;
  external?: boolean;
  /** margin-bottom override — some sections use 12px when a hint line follows */
  mb?: number;
}
const { label, meta, metaMobile, metaHref, external = false, mb = 20 } = Astro.props;
const newTab = !!metaHref && /^https?:\/\//.test(metaHref);
const hasMobile = metaMobile !== undefined;
---

<div class="section-head" style={`margin-bottom:${mb}px`}>
  <span class="label">{label}</span>
  <span class="rule" aria-hidden="true"></span>
  {
    meta &&
      (metaHref ? (
        <a
          class:list={['meta', { external }]}
          href={metaHref}
          target={newTab ? '_blank' : undefined}
          rel={newTab ? 'noopener noreferrer' : undefined}
        >
          {hasMobile ? (
            <>
              <span class="desktop-only">{meta}</span>
              <span class="mobile-only">{metaMobile}</span>
            </>
          ) : (
            meta
          )}
        </a>
      ) : hasMobile ? (
        <span class="meta">
          <span class="desktop-only">{meta}</span>
          <span class="mobile-only">{metaMobile}</span>
        </span>
      ) : (
        <span class="meta">{meta}</span>
      ))
  }
</div>

<style>
  .section-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--as-accent);
    text-transform: uppercase;
  }

  .rule {
    flex: 1;
    border-bottom: 1px solid var(--hair-rule);
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--meta);
  }

  a.meta {
    display: inline-block;
    transition:
      transform 180ms ease,
      color 180ms ease;
  }
  a.meta:hover {
    color: var(--text-hi);
  }
  a.meta.external:hover {
    transform: translate(2px, -2px);
  }

  /* mobile: labels + meta drop a notch (7a–7e) */
  @media (max-width: 768px) {
    .section-head {
      gap: 12px;
    }
    .label,
    .meta {
      font-size: 11px;
    }
  }
</style>
