---
interface Props {
  number: string | number;
  title: string;
}
const { number, title } = Astro.props;
---

<div class="step">
  <span class="num" aria-hidden="true">{number}</span>
  <h4>{title}</h4>
</div>

<style>
  .step {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 36px 0 16px;
  }

  .num {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    min-width: 30px;
    height: 30px;
    padding: 0 8px;
    border: 1px solid var(--hair-input);
    border-radius: 99px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--as-accent);
  }

  h4 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 19px;
    line-height: 1.3;
    color: var(--text-hi);
  }
</style>
