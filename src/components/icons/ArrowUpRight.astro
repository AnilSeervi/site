---
interface Props {
  size?: number;
}
const { size = 15 } = Astro.props;
---

<svg
  viewBox="0 0 16 16"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M5 11 11 5M6 5h5v5"></path>
</svg>

<style>
  svg {
    display: block;
  }
</style>
