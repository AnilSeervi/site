---
/**
 * GUESTBOOK section (frame 6d, prototype lines ~431-455) — self-contained:
 * ships its own header (the right meta toggles link ↔ 'signed in as <login>',
 * which Section.astro's fixed markup can't do), the two-column grid, and the
 * <as-guestbook>/<as-doodle> island import.
 *
 * SSR placeholders are the two design quotes; the island swaps them for
 * GET /api/guestbook and keeps them if the fetch fails. Styles are is:global
 * scoped under as-guestbook because the island creates entry nodes at runtime
 * (Astro's scoped cid wouldn't reach them).
 */
---

<as-guestbook id="guestbook" data-section="guestbook">
  <div class="gb-head">
    <span class="gb-label">GUESTBOOK</span>
    <span class="gb-rule" aria-hidden="true"></span>
    <a class="gb-auth" href="/api/auth/github" data-gb-auth>sign with github →</a>
  </div>
  <div class="gb-grid">
    <div class="gb-left">
      <label class="gb-say" data-gb-say hidden>
        <input
          type="text"
          maxlength="500"
          placeholder="say something — ↵ posts"
          aria-label="Sign the guestbook"
          autocomplete="off"
          data-gb-input
        />
        <span class="gb-key" aria-hidden="true">↵</span>
      </label>
      <div class="gb-entries" data-gb-entries>
        <div class="gb-entry">
          <span class="gb-q">“Well done thaliya honni chahiye”</span>
          <span class="gb-attr">kanaka raju · nov 2022</span>
        </div>
        <div class="gb-entry">
          <span class="gb-q">“Hey folks, welcome to my site :)”</span>
          <span class="gb-attr">the management · nov 2022</span>
        </div>
      </div>
    </div>
    <div class="gb-right">
      <span class="gb-draw-label">or draw your signature —</span>
      <as-doodle>
        <canvas width="640" height="280" aria-label="Doodle pad — draw your signature"></canvas>
      </as-doodle>
      <div class="gb-controls">
        <button type="button" class="gb-clear" data-gb-clear>↺ clear</button>
        <button type="button" class="gb-ink" data-gb-ink>ink it →</button>
      </div>
    </div>
  </div>
</as-guestbook>

<style is:global>
  as-guestbook {
    display: block;
  }

  /* section header — Section.astro pattern, meta toggled by the island */
  as-guestbook .gb-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 20px;
  }
  as-guestbook .gb-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--as-accent);
  }
  as-guestbook .gb-rule {
    flex: 1;
    border-bottom: 1px solid var(--hair-rule);
  }
  as-guestbook .gb-auth {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--as-accent);
    display: inline-block;
    transition:
      transform 180ms ease,
      color 180ms ease;
  }
  as-guestbook .gb-auth:hover {
    transform: translateX(4px);
    color: var(--text-hi);
  }
  as-guestbook .gb-auth.signed,
  as-guestbook .gb-auth.signed:hover {
    color: var(--meta);
    transform: none;
    cursor: default;
  }

  as-guestbook .gb-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 40px;
    margin-bottom: 56px;
    align-items: start;
  }

  /* left — text entry (writing-index search box styling) + entries */
  as-guestbook .gb-say {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 6px;
    padding: 9px 14px;
    border: 1px solid rgba(237, 230, 218, 0.15);
    border-radius: 5px;
    background: rgba(15, 13, 11, 0.7);
    cursor: text;
    transition: border-color 180ms ease;
  }
  as-guestbook .gb-say[hidden] {
    display: none; /* display:flex would beat the UA [hidden] rule */
  }
  as-guestbook .gb-say:hover,
  as-guestbook .gb-say:focus-within {
    border-color: rgba(237, 230, 218, 0.4);
  }
  as-guestbook .gb-say input {
    flex: 1;
    min-width: 0;
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-hi);
  }
  as-guestbook .gb-say input::placeholder {
    color: var(--faint);
  }
  as-guestbook .gb-say input:focus-visible {
    outline: none; /* focus shown on the box border via :focus-within */
  }
  as-guestbook .gb-key {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
    border: 1px solid rgba(237, 230, 218, 0.15);
    border-radius: 4px;
    padding: 1px 6px;
  }

  as-guestbook .gb-entries {
    display: flex;
    flex-direction: column;
  }
  as-guestbook .gb-entry {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4px;
    padding: 13px 0;
    border-bottom: 1px solid var(--hair-row);
  }
  as-guestbook .gb-entry:last-child {
    border-bottom: none;
  }
  as-guestbook .gb-entry.rise {
    animation: as-enter 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  as-guestbook .gb-q {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 18px;
    color: var(--quote);
  }
  as-guestbook .gb-doodle {
    display: block;
    width: 160px;
    max-width: 100%;
    height: auto;
  }
  as-guestbook .gb-attr {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--faint);
  }

  /* right — doodle pad */
  as-guestbook .gb-right {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  as-guestbook .gb-draw-label {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--meta);
  }
  as-guestbook as-doodle {
    display: block;
  }
  as-guestbook as-doodle canvas {
    width: 320px;
    height: 140px;
    display: block;
    background: var(--surface);
    border: 1px dashed rgba(237, 230, 218, 0.18);
    border-radius: 5px;
    cursor: crosshair;
    touch-action: none;
  }
  as-guestbook .gb-controls {
    display: flex;
    gap: 16px;
    font-family: var(--font-mono);
    font-size: 11.5px;
  }
  as-guestbook .gb-controls button {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    cursor: pointer;
    transition: color 180ms ease;
  }
  as-guestbook .gb-clear {
    color: var(--meta);
  }
  as-guestbook .gb-ink {
    color: var(--as-accent);
  }
  as-guestbook .gb-clear:hover,
  as-guestbook .gb-ink:hover {
    color: var(--text-hi);
  }
</style>

<script>
  import '~/islands/guestbook';
</script>
