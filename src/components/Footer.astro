---
interface Props {
  left?: string;
  /** makes `left` a link to this href */
  leftHref?: string;
}
const { left, leftHref } = Astro.props;
const year = new Date().getFullYear();
---

<footer>
  <span class="left"
    >© {year} anil seervi{left && ' — '}{
      left && (leftHref ? <a href={leftHref}>{left}</a> : left)
    }</span
  >
  <span class="right"><slot /></span>
</footer>

<style>
  footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 96px;
    border-top: 1px solid var(--hair-rule);
    padding-top: 22px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
  }

  .left a {
    color: var(--meta);
    text-decoration-line: underline;
  }
  .left a:hover {
    color: var(--text-hi);
  }

  .right {
    display: flex;
    gap: 18px;
  }

  .right :global(a) {
    color: var(--meta);
  }
  .right :global(a:hover) {
    color: var(--text-hi);
  }

  .right :global(a.chain) {
    display: inline-block;
    transition:
      transform 180ms ease,
      color 180ms ease;
  }
  .right :global(a.chain:hover) {
    transform: translateX(4px);
  }
</style>
