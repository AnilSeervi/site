---
/**
 * ⌘K command palette — mounted once in Base.astro. Rows are built in JS, and
 * JS-created nodes carry no scoped-style attribute: styles must stay is:global.
 */
import { getCollection } from 'astro:content';
import { site, paletteActions, accentOptions } from '~/config/site';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const snippets = await getCollection('snippets');

const payload = {
  pages: site.nav.map((n) => ({ label: `cd ~/${n.label}`, href: n.href })),
  actions: paletteActions,
  writing: [
    ...posts.map((p) => ({ title: p.data.title, href: `/writing/${p.id}` })),
    ...snippets.map((s) => ({ title: s.data.title, href: `/writing/${s.id}` }))
  ],
  email: site.email,
  repo: site.repo,
  accents: accentOptions
};
---

<as-palette transition:persist="as-palette">
  <script
    type="application/json"
    data-pal-data
    is:inline
    set:html={JSON.stringify(payload).replace(/</g, '\\u003c')}
  />
  <div class="pal-overlay">
    <div class="pal-panel" role="dialog" aria-modal="true" aria-label="Command palette">
      <div class="pal-handle" aria-hidden="true"></div>
      <div class="pal-prompt">
        <span class="pal-ps1" aria-hidden="true">~ ❯</span>
        <div class="pal-inputwrap">
          <!-- native caret handles mid-string editing; the fake block caret
               shows only while the input is empty (see [data-empty] rules) -->
          <input
            class="pal-input"
            type="text"
            spellcheck="false"
            autocomplete="off"
            aria-label="Type a command or search"
          />
          <div class="pal-ghost" aria-hidden="true">
            <span class="pal-ph">type a command or search…</span>
            <span class="pal-caret"></span>
          </div>
        </div>
      </div>
      <div class="pal-body" role="listbox"></div>
      <div class="pal-foot">
        <span>↑↓ navigate</span><span>↵ open</span><span>esc close</span>
        <span class="pal-right">fuzzy over pages, posts &amp; actions</span>
      </div>
      <div class="pal-foot-mobile" aria-hidden="true">
        <span>tap to run</span><span>swipe down to close</span>
        <span class="pal-right">fuzzy over everything</span>
      </div>
    </div>
  </div>
</as-palette>

<style is:global>
  as-palette {
    display: contents;
  }
  as-palette .pal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(8, 7, 6, 0.6);
    overflow-y: auto;
  }
  as-palette[data-open] .pal-overlay {
    display: block;
  }

  .pal-panel {
    width: 560px;
    max-width: calc(100vw - 32px);
    margin: 110px auto 0;
    background: #12100e;
    border: 1px solid rgba(237, 230, 218, 0.14);
    border-radius: 8px;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.6);
    overflow: hidden;
  }

  /* prompt row */
  .pal-prompt {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 18px;
    border-bottom: 1px solid rgba(237, 230, 218, 0.08);
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .pal-ps1 {
    color: var(--as-accent);
    flex: 0 0 auto;
  }
  .pal-inputwrap {
    position: relative;
    flex: 1;
    display: flex;
    min-width: 0;
  }
  .pal-input {
    width: 100%;
    background: transparent;
    border: 0;
    outline: 0;
    padding: 0;
    margin: 0;
    font: inherit;
    font-family: var(--font-mono);
    color: var(--text-hi);
    caret-color: var(--as-accent);
  }
  /* the prompt row is the focus affordance — suppress the global outline */
  .pal-input:focus-visible {
    outline: none;
  }
  as-palette[data-empty] .pal-input {
    caret-color: transparent;
  }
  .pal-ghost {
    display: none;
    position: absolute;
    inset: 0;
    align-items: center;
    gap: 10px;
    pointer-events: none;
  }
  as-palette[data-empty] .pal-ghost {
    display: flex;
  }
  .pal-ph {
    color: var(--faint);
    white-space: nowrap;
    overflow: hidden;
  }
  .pal-caret {
    flex: 0 0 auto;
    width: 8px;
    height: 17px;
    background: var(--as-accent);
    animation: as-caret 1.1s steps(1) infinite;
  }

  /* groups + rows */
  .pal-body {
    padding: 10px 8px 6px;
  }
  .pal-group-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 2px;
    color: var(--faint);
    padding: 14px 12px 6px;
  }
  .pal-group-label:first-child {
    padding-top: 8px;
  }
  .pal-rows {
    display: flex;
    flex-direction: column;
  }
  .pal-rows:last-child {
    padding-bottom: 8px;
  }
  .pal-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 9px 12px;
    border-radius: 5px;
    cursor: pointer;
  }
  .pal-label {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
    transition: color 180ms ease;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pal-label.pal-serif {
    font-family: var(--font-serif);
    font-size: 14px;
  }
  .pal-row.sel {
    background: rgba(237, 230, 218, 0.05);
    box-shadow: inset 2px 0 0 var(--as-accent);
  }
  .pal-row.sel .pal-label {
    color: var(--text-hi);
  }
  .pal-hint {
    flex: 0 0 auto;
    margin-left: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }
  .pal-hint.pal-enter {
    opacity: 0;
  }
  .pal-row.sel .pal-hint.pal-enter {
    opacity: 1;
  }
  .pal-none {
    padding: 9px 12px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--faint);
  }

  /* footer bar */
  .pal-foot {
    display: flex;
    gap: 18px;
    padding: 12px 18px;
    border-top: 1px solid rgba(237, 230, 218, 0.08);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }
  .pal-right {
    margin-left: auto;
  }

  /* drag handle + mobile hint bar — hidden on desktop */
  .pal-handle,
  .pal-foot-mobile {
    display: none;
  }

  /* ---- bottom-sheet (≤768px) ---- */
  @media (max-width: 768px) {
    as-palette .pal-overlay {
      background: rgba(8, 7, 6, 0.78);
    }
    as-palette[data-open] .pal-overlay {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      /* visualViewport-driven when the keyboard is open (set in JS) */
      height: var(--pal-vvh, 100%);
      top: var(--pal-vvt, 0);
    }
    .pal-panel {
      width: 100%;
      max-width: none;
      margin: 0;
      border: 0;
      border-top: 1px solid rgba(237, 230, 218, 0.14);
      border-radius: 20px 20px 0 0;
      box-shadow: 0 -20px 60px rgba(0, 0, 0, 0.55);
      will-change: transform;
    }
    .pal-handle {
      display: block;
      width: 36px;
      height: 4px;
      border-radius: 99px;
      background: rgba(237, 230, 218, 0.2);
      margin: 10px auto 4px;
    }
    .pal-foot {
      display: none;
    }
    .pal-foot-mobile {
      display: flex;
      gap: 16px;
      padding: 10px 20px;
      border-top: 1px solid rgba(237, 230, 218, 0.08);
      font-family: var(--font-mono);
      font-size: 10.5px;
      color: var(--faint);
    }
    /* shortcut hints are meaningless on touch; the ↵ on the active row stays */
    .pal-hint:not(.pal-enter) {
      display: none;
    }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  import { isMobile } from '~/islands/breakpoint';

  interface PalItem {
    kind: 'page' | 'action' | 'writing';
    label: string;
    serif?: boolean;
    hint?: string;
    href?: string;
    action?: string;
  }

  if (!customElements.get('as-palette')) {
    class AsPalette extends HTMLElement {
      private data!: {
        pages: { label: string; href: string }[];
        actions: { label: string; hint?: string; action: string }[];
        writing: { title: string; href: string }[];
        email: string;
        repo: string;
        accents: string[];
      };
      private input!: HTMLInputElement;
      private body!: HTMLElement;
      private overlay!: HTMLElement;
      private panel!: HTMLElement;
      private items: PalItem[] = [];
      private index = 0;
      private copyTimer: ReturnType<typeof setTimeout> | null = null;
      private bound = false;
      private dragY = 0;
      private dragging = false;
      private vvHandler: (() => void) | null = null;

      connectedCallback() {
        this.data = JSON.parse(this.querySelector('[data-pal-data]')!.textContent!);
        this.input = this.querySelector('.pal-input')!;
        this.body = this.querySelector('.pal-body')!;
        this.overlay = this.querySelector('.pal-overlay')!;
        this.panel = this.querySelector('.pal-panel')!;
        this.setAttribute('data-empty', '');
        // the element persists across view transitions; guard against double-binding
        if (this.bound) return;
        this.bound = true;
        this.input.addEventListener('input', () => {
          this.toggleAttribute('data-empty', this.input.value === '');
          this.render();
        });
        this.overlay.addEventListener('click', (e) => {
          const t = e.target as Element;
          const row = t.closest('.pal-row') as HTMLElement | null;
          if (row) {
            this.run(this.items[Number(row.dataset.i)]);
            return;
          }
          if (!t.closest('.pal-panel')) this.close();
        });
        this.overlay.addEventListener('mouseover', (e) => {
          const row = (e.target as Element).closest('.pal-row') as HTMLElement | null;
          if (row) this.select(Number(row.dataset.i));
        });

        // swipe-down to dismiss: drag only from scrollTop 0, else the flick is a scroll
        this.panel.addEventListener(
          'touchstart',
          (e) => {
            if (this.body.scrollTop > 0) return;
            this.dragging = true;
            this.dragY = e.touches[0].clientY;
          },
          { passive: true }
        );
        this.panel.addEventListener(
          'touchmove',
          (e) => {
            if (!this.dragging) return;
            const dy = e.touches[0].clientY - this.dragY;
            if (dy <= 0) {
              this.panel.style.transform = '';
              return;
            }
            e.preventDefault();
            this.panel.style.transform = `translateY(${dy}px)`;
          },
          { passive: false }
        );
        const endDrag = (e: TouchEvent) => {
          if (!this.dragging) return;
          this.dragging = false;
          const dy = (e.changedTouches[0]?.clientY ?? this.dragY) - this.dragY;
          this.panel.style.transition = 'transform 180ms ease';
          this.panel.style.transform = '';
          setTimeout(() => (this.panel.style.transition = ''), 200);
          if (dy > 80) this.close();
        };
        this.panel.addEventListener('touchend', endDrag);
        this.panel.addEventListener('touchcancel', endDrag);
      }

      disconnectedCallback() {
        if (this.copyTimer) clearTimeout(this.copyTimer);
        this.copyTimer = null;
        this.detachViewport();
      }

      /** keep the sheet above the on-screen keyboard (visualViewport) */
      private attachViewport() {
        const vv = window.visualViewport;
        if (!vv || this.vvHandler) return;
        this.vvHandler = () => {
          this.overlay.style.setProperty('--pal-vvh', `${vv.height}px`);
          this.overlay.style.setProperty('--pal-vvt', `${vv.offsetTop}px`);
        };
        this.vvHandler();
        vv.addEventListener('resize', this.vvHandler);
        vv.addEventListener('scroll', this.vvHandler);
      }
      private detachViewport() {
        const vv = window.visualViewport;
        if (vv && this.vvHandler) {
          vv.removeEventListener('resize', this.vvHandler);
          vv.removeEventListener('scroll', this.vvHandler);
        }
        this.vvHandler = null;
        this.overlay.style.removeProperty('--pal-vvh');
        this.overlay.style.removeProperty('--pal-vvt');
      }

      get isOpen() {
        return this.hasAttribute('data-open');
      }

      open() {
        this.input.value = '';
        this.setAttribute('data-empty', '');
        this.setAttribute('data-open', '');
        this.panel.style.transform = '';
        this.render();
        this.attachViewport();
        requestAnimationFrame(() => this.input.focus());
      }

      close() {
        this.removeAttribute('data-open');
        if (this.copyTimer) {
          clearTimeout(this.copyTimer);
          this.copyTimer = null;
        }
        this.detachViewport();
        this.input.blur();
      }

      toggle() {
        this.isOpen ? this.close() : this.open();
      }

      /** case-insensitive subsequence score: consecutive/word-start bonuses, spread penalty */
      private static score(query: string, text: string): number {
        const q = query.toLowerCase();
        const t = text.toLowerCase();
        let qi = 0;
        let s = 0;
        let last = -2;
        let first = -1;
        for (let ti = 0; ti < t.length && qi < q.length; ti++) {
          if (t[ti] !== q[qi]) continue;
          s += 1;
          if (ti === last + 1) s += 2;
          if (ti === 0 || /[\s/~._\-→]/.test(t[ti - 1])) s += 3;
          if (first < 0) first = ti;
          last = ti;
          qi++;
        }
        if (qi !== q.length) return -1;
        return s - (last - first + 1 - q.length) * 0.5;
      }

      private render() {
        const q = this.input.value.trim();
        const groups: { label: string; items: PalItem[] }[] = [];
        const pages: PalItem[] = this.data.pages.map((p) => ({
          kind: 'page',
          label: p.label,
          href: p.href
        }));
        const actions: PalItem[] = this.data.actions
          .filter((a) => !isMobile() || a.action !== 'open-feed')
          .map((a) => ({
            kind: 'action',
            label: a.label,
            hint: a.hint,
            action: a.action
          }));
        if (!q) {
          groups.push({ label: 'PAGES', items: pages });
          groups.push({ label: 'ACTIONS', items: actions });
        } else {
          const match = (list: PalItem[]) =>
            list
              .map((it) => ({ it, s: AsPalette.score(q, it.label) }))
              .filter((r) => r.s >= 0)
              .sort((a, b) => b.s - a.s);
          const writing: PalItem[] = this.data.writing.map((w) => ({
            kind: 'writing',
            label: w.title,
            serif: true,
            href: w.href
          }));
          // sort groups by best score so row 0 (the Enter target) is the top hit overall
          const scored = [
            { label: 'PAGES', rows: match(pages) },
            { label: 'WRITING', rows: match(writing) },
            { label: 'ACTIONS', rows: match(actions) }
          ]
            .filter((g) => g.rows.length)
            .sort((a, b) => (b.rows[0]?.s ?? -1) - (a.rows[0]?.s ?? -1));
          for (const g of scored) groups.push({ label: g.label, items: g.rows.map((r) => r.it) });
        }

        this.items = groups.flatMap((g) => g.items);
        this.index = 0;
        let i = 0;
        const esc = (s: string) =>
          s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        this.body.innerHTML = groups.length
          ? groups
              .map(
                (g) =>
                  `<div class="pal-group-label">${g.label}</div><div class="pal-rows">` +
                  g.items
                    .map((it) => {
                      const hint = it.hint
                        ? `<span class="pal-hint">${esc(it.hint)}</span>`
                        : `<span class="pal-hint pal-enter">↵</span>`;
                      return `<div class="pal-row${i === this.index ? ' sel' : ''}" role="option" id="pal-opt-${i}" aria-selected="${i === this.index}" data-i="${i++}"><span class="pal-label${it.serif ? ' pal-serif' : ''}">${esc(it.label)}</span>${hint}</div>`;
                    })
                    .join('') +
                  `</div>`
              )
              .join('')
          : `<div class="pal-none">no matches — esc to close</div>`;
        if (this.items.length) this.input.setAttribute('aria-activedescendant', 'pal-opt-0');
        else this.input.removeAttribute('aria-activedescendant');
      }

      private select(i: number) {
        if (!this.items.length) return;
        this.index = (i + this.items.length) % this.items.length;
        this.body.querySelectorAll('.pal-row').forEach((r) => {
          const on = Number((r as HTMLElement).dataset.i) === this.index;
          r.classList.toggle('sel', on);
          r.setAttribute('aria-selected', String(on));
        });
        const sel = this.body.querySelector('.pal-row.sel');
        if (sel) this.input.setAttribute('aria-activedescendant', sel.id);
        sel?.scrollIntoView({ block: 'nearest' });
      }

      move(delta: number) {
        this.select(this.index + delta);
      }

      runSelected() {
        this.run(this.items[this.index]);
      }

      private run(item: PalItem | undefined) {
        if (!item) return;
        if (item.href) {
          // navigate(), not location — a hard load skips the view transition
          this.close();
          navigate(item.href);
          return;
        }
        switch (item.action) {
          case 'copy-email': {
            navigator.clipboard?.writeText(this.data.email).catch(() => {});
            const row = this.body.querySelectorAll('.pal-row')[this.index];
            const label = row?.querySelector('.pal-label');
            if (label) label.textContent = 'copied ✓';
            if (this.copyTimer) clearTimeout(this.copyTimer);
            this.copyTimer = setTimeout(() => {
              this.copyTimer = null;
              this.close();
            }, 1200);
            return;
          }
          case 'open-src':
            window.open(this.data.repo);
            break;
          case 'open-feed':
            location.href = '/rss.xml';
            break;
          case 'cycle-accent': {
            let cur = '';
            try {
              cur = localStorage.getItem('as-accent') || '';
            } catch {}
            if (!cur)
              cur = getComputedStyle(document.documentElement)
                .getPropertyValue('--as-accent')
                .trim();
            const idx = this.data.accents.findIndex((c) => c.toLowerCase() === cur.toLowerCase());
            const next = this.data.accents[(idx + 1) % this.data.accents.length];
            document.documentElement.style.setProperty('--as-accent', next);
            try {
              localStorage.setItem('as-accent', next);
            } catch {}
            break;
          }
        }
        this.close();
      }
    }

    customElements.define('as-palette', AsPalette);

    // module-level delegation: Astro dedupes scripts across view transitions,
    // so this module runs once and these listeners are never doubled
    const pal = () => document.querySelector<AsPalette>('as-palette');

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
        e.preventDefault();
        pal()?.toggle();
        return;
      }
      const p = pal();
      if (!p || !p.isOpen) return; // '/' intentionally does NOT open (writing search owns it)
      if (e.key === 'Escape') {
        e.preventDefault();
        p.close();
      } else if (e.key === 'Tab') {
        // focus trap: the input is the only focusable control in this aria-modal dialog
        e.preventDefault();
        p.querySelector<HTMLInputElement>('.pal-input')?.focus();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        p.move(1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        p.move(-1);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        p.runSelected();
      }
    });

    document.addEventListener('click', (e) => {
      if ((e.target as Element).closest?.('[data-palette-open]')) pal()?.open();
    });
  }
</script>
